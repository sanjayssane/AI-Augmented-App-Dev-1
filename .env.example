# Copy to .env at repo root for docker compose and local backend dev.
# Do not commit .env.

# Application
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL (docker compose defaults)
POSTGRES_USER=mcq
POSTGRES_PASSWORD=mcq_dev_password
POSTGRES_DB=mcq_platform
DATABASE_URL=postgresql+psycopg://mcq:mcq_dev_password@localhost:5432/mcq_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Frontend (host dev — see frontend/.env.example)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
